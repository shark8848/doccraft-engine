# 本地开发：PostgreSQL 与 Elasticsearch 由本机服务提供
DOCCRAFT_ENV=dev
DOCCRAFT_HOST=127.0.0.1
DOCCRAFT_PORT=8100
DOCCRAFT_DATABASE_URL=postgresql+psycopg://open-ikc-platform:1qaz2wsx3edc@127.0.0.1:5432/doccraft

DOCCRAFT_ES_URL=https://127.0.0.1:9200
DOCCRAFT_ES_USERNAME=elastic
DOCCRAFT_ES_PASSWORD=change-me
DOCCRAFT_ES_VERIFY_TLS=false
DOCCRAFT_ES_INDEX_PREFIX=doccraft

DOCCRAFT_PYUPLOADX_BASE_URL=http://127.0.0.1:8000
DOCCRAFT_PYUPLOADX_API_KEY=dev-key
DOCCRAFT_PYUPLOADX_BUCKET=ikc-core
DOCCRAFT_PYUPLOADX_STATE_DIR=~/.pyuploadx/uploads

DOCCRAFT_AUTH_MODE=dev
DOCCRAFT_DEFAULT_TENANT=default
DOCCRAFT_DEFAULT_USER=dev-user
DOCCRAFT_DEFAULT_ROLE=publisher
DOCCRAFT_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5290
DOCCRAFT_MEDIA_MAX_BYTES=52428800

DOCCRAFT_HTTP_PORT=5290
DOCCRAFT_STATS_PORT=8411
